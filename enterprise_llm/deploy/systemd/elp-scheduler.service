[Unit]
Description=ELP nightly maintenance re-forecast
After=elp-gateway.service

[Service]
Type=oneshot
User=elp
Group=elp
WorkingDirectory=/opt/elp
EnvironmentFile=/opt/elp/.env
Environment=PATH=/opt/elp/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/elp/.venv/bin/python scripts/nightly_forecast.py
