# =====================================================================
# Enterprise LLM Platform - configuration
# Copy to .env and fill in. Nested settings use a double underscore.
# =====================================================================

ELP_ENVIRONMENT=production
ELP_HOST=0.0.0.0
ELP_PORT=8080
ELP_LOG_LEVEL=INFO

# Browser origins of in-house web apps that call this API directly.
ELP_CORS_ORIGINS=https://maintenance.corp.internal,https://ops.corp.internal

# ---------------------------------------------------------------------
# Database (PostgreSQL 16+ with the pgvector extension)
# ---------------------------------------------------------------------
ELP_DATABASE_URL=postgresql+asyncpg://elp:CHANGE_ME@127.0.0.1:5432/elp
ELP_DB_POOL_SIZE=10
ELP_DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------
# Local inference (vLLM on the RTX 5090)
# ---------------------------------------------------------------------
ELP_INFERENCE__CHAT_BASE_URL=http://127.0.0.1:8101/v1
ELP_INFERENCE__CHAT_MODEL=Qwen/Qwen3-32B-AWQ
ELP_INFERENCE__EMBED_BASE_URL=http://127.0.0.1:8102/v1
ELP_INFERENCE__EMBED_MODEL=BAAI/bge-m3
# Must match the model's output dimension. Changing it requires a full
# re-index (scripts/reindex.py).
ELP_INFERENCE__EMBED_DIM=1024
ELP_INFERENCE__RERANK_URL=http://127.0.0.1:8103/rerank
ELP_INFERENCE__RERANK_MODEL=BAAI/bge-reranker-v2-m3
ELP_INFERENCE__MAX_CONTEXT_TOKENS=32768
ELP_INFERENCE__MAX_OUTPUT_TOKENS=2048

# Optional: a second endpoint dedicated to code work. Leave blank to use the
# chat model for everything (correct for a single 32 GB card).
ELP_INFERENCE__CODE_BASE_URL=
ELP_INFERENCE__CODE_MODEL=

# ---------------------------------------------------------------------
# Authentication: "oidc" (Entra ID / ADFS / Keycloak), "ldap", "disabled"
# ---------------------------------------------------------------------
ELP_AUTH__MODE=oidc

# --- Microsoft Entra ID -----------------------------------------------
ELP_AUTH__OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ELP_AUTH__OIDC_CLIENT_ID=<application-client-id>
ELP_AUTH__OIDC_AUDIENCE=api://<application-client-id>
ELP_AUTH__OIDC_CLIENT_SECRET=
# Entra emits group OBJECT IDs on "groups" unless the app registration is
# configured to emit sAMAccountName. Either works - map whatever arrives.
ELP_AUTH__GROUPS_CLAIM=groups
ELP_AUTH__ROLES_CLAIM=roles

# --- ADFS 2019+ -------------------------------------------------------
# ELP_AUTH__OIDC_ISSUER=https://adfs.corp.internal/adfs
# ELP_AUTH__GROUPS_CLAIM=group

# --- Direct Active Directory bind (no identity provider) --------------
# ELP_AUTH__MODE=ldap
# ELP_AUTH__LDAP_URL=ldaps://dc01.corp.internal:636
# ELP_AUTH__LDAP_BIND_DN=CN=svc-elp,OU=Service Accounts,DC=corp,DC=internal
# ELP_AUTH__LDAP_BIND_PASSWORD=
# ELP_AUTH__LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=internal
# In LDAP mode this secret signs the session tokens the platform issues.
# ELP_AUTH__OIDC_CLIENT_SECRET=<a long random string>

# --- AD group -> platform role ----------------------------------------
# Roles: admin, engineer, planner, maintenance_manager, developer, reader
ELP_AUTH__GROUP_ROLE_MAP={"AW139-Maint-Admins":"admin","AW139-Engineering":"engineer","AW139-Planning":"planner","AW139-Maint-Managers":"maintenance_manager","IT-Developers":"developer","AW139-All-Staff":"reader"}

# Groups permitted to use the platform at all. Empty = any authenticated
# user, still subject to per-document access control.
ELP_AUTH__ALLOWED_GROUPS=["AW139-All-Staff","AW139-Engineering","AW139-Planning","AW139-Maint-Admins","AW139-Maint-Managers","IT-Developers"]
ELP_AUTH__DEFAULT_ROLE=reader
ELP_AUTH__API_KEY_HEADER=X-API-Key

# ---------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------
ELP_RAG__CHUNK_TARGET_TOKENS=700
ELP_RAG__CHUNK_OVERLAP_TOKENS=90
ELP_RAG__VECTOR_TOP_K=40
ELP_RAG__KEYWORD_TOP_K=40
ELP_RAG__FINAL_TOP_K=8
ELP_RAG__MIN_ANSWER_CONFIDENCE=0.12
# Platform admins do not bypass document ACLs by default.
ELP_RAG__ADMIN_BYPASS_ACL=false

# ---------------------------------------------------------------------
# Federation with other internal AI systems
# ---------------------------------------------------------------------
ELP_FEDERATION__ENABLED=true
ELP_FEDERATION__AUTO_CONSULT=true
ELP_FEDERATION__MAX_PEERS_PER_QUERY=3
ELP_FEDERATION__PER_PEER_TIMEOUT_S=45
# Peer credentials are read from the environment variables named in
# config/peers.yaml, for example:
# PEER_RELIABILITY_TOKEN=
# PEER_INVENTORY_KEY=

# ---------------------------------------------------------------------
# Maintenance scheduling
# ---------------------------------------------------------------------
ELP_MAINTENANCE__UTILIZATION_WINDOW_DAYS=90
ELP_MAINTENANCE__DEFAULT_DAILY_FLIGHT_HOURS=2.0
ELP_MAINTENANCE__FORECAST_HORIZON_DAYS=365
ELP_MAINTENANCE__PLANNING_HORIZON_DAYS=120
ELP_MAINTENANCE__BUNDLING_WINDOW_DAYS=14
ELP_MAINTENANCE__SHIFT_HOURS_PER_DAY=8
ELP_MAINTENANCE__TECHNICIANS_PER_SHIFT=4
ELP_MAINTENANCE__MAX_CONCURRENT_AIRCRAFT_DOWN=2

# ---------------------------------------------------------------------
# LaTeX
# ---------------------------------------------------------------------
ELP_LATEX__ENABLED=true
ELP_LATEX__ENGINE=tectonic
ELP_LATEX__COMPILE_TIMEOUT_S=120

# ---------------------------------------------------------------------
# Operational reporting (NAMIS)
# ---------------------------------------------------------------------
ELP_REPORTS__ENABLED=true
ELP_REPORTS__NAMIS_KIND=sql

# NAMIS is Microsoft SQL Server. The dialect decides row-limit syntax
# (TOP vs LIMIT) — the wrong value is a syntax error on every query.
ELP_REPORTS__SQL_DIALECT=mssql

# Requires the Microsoft ODBC Driver 18 for SQL Server and unixODBC on the
# host. The four NAMIS databases (NAMISNNSS, AMO_NASAWeb, OpsDBAMO,
# WebSupport_NASAWeb) live on one instance and are reached with three-part
# names, so Initial Catalog is only the default.
#
# The platform is a HEADLESS SERVICE: a report firing at 03:00 has no
# signed-in user, so Integrated Security is not an option here. Use a
# dedicated read-only SQL login — which is also the control that makes the
# read-only guarantee real.
ELP_REPORTS__NAMIS_DSN=mssql+aioodbc://elp_reports_ro:${PASSWORD}@24pwnmsap001.nts.ops:1433/NAMISNNSS?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
ELP_REPORTS__NAMIS_AUTH_ENV_VAR=NAMIS_PASSWORD

# TrustServerCertificate=yes is required against the on-prem self-signed
# certificate — the same combination the production ops apps use. Prefer a
# trusted certificate and drop it when one is installed.

# SQL Server application role. Leave BOTH EMPTY unless the reporting login
# lacks direct SELECT rights: querying with the login's own permissions is
# the better posture, and avoids putting the shared role password anywhere.
ELP_REPORTS__NAMIS_APP_ROLE=
ELP_REPORTS__NAMIS_APP_ROLE_ENV_VAR=NAMIS_APP_ROLE_PASSWORD

# Reporting takes shared locks that can block technicians using NAMIS.
# READ COMMITTED is correct but can queue behind writers. SNAPSHOT is ideal
# where the DBA has enabled it. READ UNCOMMITTED never blocks but permits
# dirty reads — a poor trade for maintenance records.
ELP_REPORTS__MSSQL_ISOLATION_LEVEL=READ COMMITTED

# The field catalogue exported by the NAMIS report generator: 585 tables,
# 8,231 columns and 723 join relationships. This is what lets the model
# write correct joins, and it also serves as the table allowlist. Deploy it
# alongside the config; it is not committed to the repository.
ELP_REPORTS__CATALOG_PATH=/opt/elp/config/namis-catalog.json
ELP_REPORTS__CATALOG_TABLES_PER_REQUEST=18

# Leave the allowlist empty to let the catalogue define it — a table absent
# from the catalogue is one the report generator never knew about.
ELP_REPORTS__ALLOWED_SCHEMAS=[]
ELP_REPORTS__ALLOWED_TABLES=[]

ELP_REPORTS__REDACTED_COLUMNS=["password","passwd","secret","token","ssn","cpf"]
ELP_REPORTS__MAX_ROWS=5000
ELP_REPORTS__STATEMENT_TIMEOUT_MS=30000
ELP_REPORTS__NARRATION_ROW_SAMPLE=50
ELP_REPORTS__REQUIRE_APPROVAL_FOR_SCHEDULE=true
ELP_REPORTS__RUN_RETENTION_DAYS=365

# Secrets belong in a root-owned file read by the systemd unit
# (/etc/elp/namis.env, chmod 600), never here:
# NAMIS_PASSWORD=
# NAMIS_APP_ROLE_PASSWORD=

# ---------------------------------------------------------------------
# Application development assistance
# ---------------------------------------------------------------------
ELP_DEV__ENABLED=true
# Absolute paths the code assistant may read. Nothing outside these is opened.
ELP_DEV__WORKSPACE_ROOTS=["/srv/repos"]
